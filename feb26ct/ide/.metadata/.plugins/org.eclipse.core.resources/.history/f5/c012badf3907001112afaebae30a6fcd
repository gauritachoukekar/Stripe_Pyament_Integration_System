package com.mycompany.my_first_app.controller;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

import com.mycompany.my_first_app.service.interfaces.AddService;

@RestController
public class AddController {
	//create a logger object using SLF4J with logback as the implementation
	private static final org.slf4j.Logger logger = LoggerFactory.getLogger(AddController.class);
	

    @Autowired
    private AddService addService;

    @GetMapping("/add")
    public int addGet(@RequestParam int val1,
                   @RequestParam int val2) {
    	Logger.info(AddController.addGet() + " called with parameters: val1=" + val1 + ", val2=" + val2);
    	logger.info("Calling AddService to perform addition");
        return addService.add(val1, val2);
    }
}

