package com.mycompany.my_first_app.controller;

import com.mycompany.my_first_app.service.interfaces.AddService;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class AddController {
    //create logger object using  Slf4j with Logback implementation
	

    @Autowired
    private AddService addService;

    @GetMapping("/add")
    public int add(
            @RequestParam int val1,
            @RequestParam int val2) {
    

        return addService.add(val1, val2);
    }
}

